[Unit]
Description=Waldur site agent: syncing memberships (polling)
Wants=network-online.target
After=network-online.target

[Service]
User=root
Group=root
ExecStart=waldur_site_agent -m membership_sync -c /etc/waldur/waldur-site-agent-config.yaml
# Each unit gets its own liveness heartbeat, so a healthy unit on the same host
# cannot keep a stalled one looking alive (checked by waldur_site_healthz).
RuntimeDirectory=waldur-site-agent-membership-sync
Environment=WALDUR_SITE_AGENT_HEARTBEAT_PATH=/run/waldur-site-agent-membership-sync/heartbeat
Restart=on-failure
RestartSec=30
# Write output to files instead of the journal. StandardOutput=append: needs
# systemd 240 or newer; rotate these files with logrotate (copytruncate).
StandardOutput=append:/var/log/waldur-site-agent-membership-sync.log
StandardError=append:/var/log/waldur-site-agent-membership-sync-error.log

[Install]
WantedBy=multi-user.target
